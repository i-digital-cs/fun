APP_NAME="Community Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Keep public profiles indexable. Set to false only after an owner decision
# to emit noindex,follow on /u/{publicId}. Profiles are never in the sitemap.
SEO_PUBLIC_PROFILES_INDEXABLE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Supported UI locales: en (LTR), ar (RTL)

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Prefer MySQL/MariaDB in shared environments; sqlite remains available for local tests.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fun_community
DB_USERNAME=root
DB_PASSWORD=

# Local/testing fallback:
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting
# Shared hosting: use "pusher" (Pusher Channels — no long-running WS process).
# VPS alternative: "reverb" + REVERB_HOST=your-domain REVERB_PORT=443 REVERB_SCHEME=https
# Offline / no keys: "log" (HTTP chat works; no live WebSocket).
BROADCAST_CONNECTION=pusher

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Optional self-hosted Reverb (unused when BROADCAST_CONNECTION=pusher)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Media ---
# Local scaffold (default):
MEDIA_DISK=media
MEDIA_PRIVATE_DISK=media_private

# Production Cloudflare R2 (S3-compatible):
# 1) Create public + private R2 buckets (or one private + public CDN on public bucket)
# 2) Create R2 API token with Object Read/Write
# 3) Set credentials and switch disks:
# MEDIA_DISK=r2
# MEDIA_PRIVATE_DISK=r2_private
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=your-public-media-bucket
# R2_PRIVATE_BUCKET=your-private-docs-bucket  # required separately; never reuse R2_BUCKET
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_URL=https://media.your-domain.com
# R2_PRIVATE_URL=
# R2_REGION=auto
# R2_USE_PATH_STYLE_ENDPOINT=false
# R2_THROW=true

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_ENDPOINT=
R2_URL=
R2_PRIVATE_URL=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
R2_THROW=true
R2_ROOT=
R2_PRIVATE_ROOT=

# Optional AWS S3 compatibility leftovers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
# Production example: funnity.com,www.funnity.com

# Google OAuth
# Web client (Socialite + Flutter serverClientId / ID token audience)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Optional platform clients (ID token `aud` may be these instead of the web client)
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Firebase auto Web client from google-services.json (client_type 3)
GOOGLE_FIREBASE_WEB_CLIENT_ID=

# Sign in with Apple (comma-separated audiences: iOS bundle id and/or Services ID)
APPLE_CLIENT_IDS=
# ACCOUNT_DELETION_GRACE_DAYS=30

# Weather (Open-Meteo — free, no API key)
WEATHER_DRIVER=open_meteo
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=30
WEATHER_FORECAST_DAYS=5

# Firebase Cloud Messaging (optional until Flutter/web push is enabled)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Living Map V3.3 Home/Dashboard activation (default false = Leaflet mini map)
LIVING_MAP_REPLACE_HOME=false
LIVING_MAP_REPLACE_DISCOVER=false
